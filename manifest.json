{
  "manifest_version": 2,
  "name": "WhatsBlock Profile Images",
  "version": "1.1.0",
  "description": "Bloquea las fotos de perfil en WhatsApp Web y las sustituye por un avatar genérico (con iniciales cuando es posible).",
  "browser_specific_settings": {
    "gecko": {
      "id": "whatsblock-profile-images@local",
      "strict_min_version": "142.0",
      "update_url": "https://raw.githubusercontent.com/KaeserSan/WhatsBlockProfileImages/main/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "tabs",
    "*://*.whatsapp.net/*",
    "*://web.whatsapp.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "WhatsBlock: activo (clic para desactivar)"
  },
  "content_scripts": [
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": ["avatar.svg"]
}
